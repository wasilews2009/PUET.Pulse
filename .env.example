# Copy to .env and replace every CHANGE_ME value. Never commit .env.
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=puet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=puet_pulse
DATABASE_URL=postgresql://puet:CHANGE_ME@localhost:5432/puet_pulse?schema=public

# Redis (pub/sub, presence, Quiet Hours queues, rate limiting)
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# MinIO (S3-compatible object storage, SSE with KMS key)
MINIO_ROOT_USER=puet-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_16_CHARS
# 32-byte base64 key: openssl rand -base64 32
MINIO_KMS_SECRET_KEY=puet-pulse-kms:CHANGE_ME_BASE64_32_BYTES
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ATTACHMENTS=puet-attachments
S3_BUCKET_QUARANTINE=puet-quarantine
# Dedicated API access key (not the root user), read/write on the two buckets only
S3_ACCESS_KEY_ID=puet-api
S3_SECRET_ACCESS_KEY=CHANGE_ME_MIN_32_CHARS
S3_REGION=us-east-1

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# API
API_PORT=3000
# Comma-separated list of trusted reverse proxies for X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1

# Web client origin (CSRF check and post-login redirects)
WEB_ORIGIN=http://localhost:5173

# OIDC / SSO (Keycloak realm federated with AD / LDAP). MFA is enforced by the IdP;
# the API reads the acr / amr claims of the ID token.
OIDC_ISSUER_URL=https://sso.puet.edu.ua/realms/puet
OIDC_CLIENT_ID=puet-pulse
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_MFA_ACR_VALUES=mfa,2
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk,totp,webauthn
OIDC_STEP_UP_ACR=mfa
SESSION_ABSOLUTE_HOURS=10
SESSION_IDLE_MINUTES=30

# Signed webhooks. One entry per integration client; secrets >= 32 chars (openssl rand -hex 32).
# id is a fixed UUID used as the actor in the audit log.
INTEGRATION_CLIENTS={"edebo":{"id":"00000000-0000-4000-8000-000000000001","secret":"CHANGE_ME_64_HEX_CHARS_CHANGE_ME_64_HEX_CHARS","tenantCode":"PUET_MAIN","kinds":["EDEBO_STUDENTS","OFFBOARDING"]},"hr":{"id":"00000000-0000-4000-8000-000000000002","secret":"CHANGE_ME_64_HEX_CHARS_CHANGE_ME_64_HEX_CHARS","tenantCode":"PUET_MAIN","kinds":["HR_STAFF","TEACHING_LOAD","OFFBOARDING"]}}
INTEGRATION_CLOCK_TOLERANCE_SECONDS=300

# ─── Phase 3: messaging, realtime, E2EE ───
# Server name inside E2EE identifiers (@<user>:<name>). Never change it after launch.
E2EE_SERVER_NAME=pulse.puet.edu.ua
# Background jobs (morning digests, TTL purge, course auto-archive). One leader runs them.
JOBS_ENABLED=true

# ─── Phase 4: files, Secure PDF Viewer, PKI, QES ───
# Upload limit (MB). Uploads are scanned by ClamAV right away; a job retries if clamd is down.
FILE_MAX_MB=50
FILE_SCAN_INLINE=true
# Internal university CA (УЕП). Create once: pnpm --filter @puet/api pki:init-ca /etc/puet/ca
# Keep these files outside the repository, readable only by the API user.
PKI_CA_CERT_FILE=/etc/puet/ca/ca.crt.pem
PKI_CA_KEY_FILE=/etc/puet/ca/ca.key.pem
# Public base URL written into certificates (CRL, OCSP, CA issuer). Default: WEB_ORIGIN + /api
PKI_PUBLIC_URL=https://pulse.puet.edu.ua/api
PKI_CERT_DAYS=365
# Secret for the QR verification links and QES binding challenges: openssl rand -hex 32
# Rotating it invalidates printed QR codes.
VERIFY_CODE_SECRET=CHANGE_ME_64_HEX_CHARS_CHANGE_ME_64_HEX_CHARS
# On-premise QES gateway (IIT EUSignCP server) for КЕП. Leave empty to disable КЕП.
QES_GATEWAY_URL=
QES_GATEWAY_TOKEN=

# ─── Phase 7: WebRTC consultations (LiveKit SFU, on-premise) ───
# Leave LIVEKIT_URL empty to disable calls. The API signs 5-minute join tokens and receives
# webhooks at POST /api/calls/livekit/webhook (configure it in livekit.yaml).
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://meet.pulse.puet.edu.ua
LIVEKIT_API_KEY=
# At least 32 characters: openssl rand -hex 32
LIVEKIT_API_SECRET=
