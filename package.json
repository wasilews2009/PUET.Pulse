{
  "name": "puet-pulse",
  "private": true,
  "description": "PUET.Pulse: on-premise corporate messenger of Poltava University of Economics and Trade",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @puet/database run generate",
    "db:migrate": "pnpm --filter @puet/database run migrate:dev",
    "db:deploy": "pnpm --filter @puet/database run migrate:deploy",
    "db:seed": "pnpm --filter @puet/database run seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
