# Settings for a TRIAL RUN on one computer (docs/DEPLOYMENT.md, part 1).
#   cp infra/demo.env.example .env
# Every value here is public and local-only. NEVER use this file on a server:
# for the university copy .env.example and generate real secrets instead.
NODE_ENV=development

POSTGRES_USER=puet
POSTGRES_PASSWORD=trial-only-postgres
POSTGRES_DB=puet_pulse
DATABASE_URL=postgresql://puet:trial-only-postgres@localhost:5432/puet_pulse?schema=public

REDIS_PASSWORD=trial-only-redis
REDIS_URL=redis://:trial-only-redis@localhost:6379/0

MINIO_ROOT_USER=puet-admin
MINIO_ROOT_PASSWORD=trial-only-minio-root
MINIO_KMS_SECRET_KEY=puet-pulse-kms:dHJpYWwtb25seS1rZXktMzItYnl0ZXMtbG9uZyEhISE=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ATTACHMENTS=puet-attachments
S3_BUCKET_QUARANTINE=puet-quarantine
S3_ACCESS_KEY_ID=puet-api
S3_SECRET_ACCESS_KEY=trial-only-minio-api-secret-0123456789
S3_REGION=us-east-1

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

API_PORT=3000
TRUSTED_PROXIES=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Demo Keycloak from docker compose --profile demo (infra/keycloak/puet-realm.json)
KC_BOOTSTRAP_ADMIN_PASSWORD=trial-only-keycloak-admin
OIDC_ISSUER_URL=http://localhost:8080/realms/puet
OIDC_CLIENT_ID=puet-pulse
OIDC_CLIENT_SECRET=demo-client-secret-local-only
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# The "demo" client is used by pnpm demo:data to load the fictional people.
INTEGRATION_CLIENTS={"demo":{"id":"00000000-0000-4000-8000-0000000000de","secret":"trial-only-integration-secret-0123456789abcdef","tenantCode":"PUET_MAIN","kinds":["HR_STAFF","EDEBO_STUDENTS","TEACHING_LOAD","OFFBOARDING"]}}

E2EE_SERVER_NAME=localhost
JOBS_ENABLED=true
FILE_MAX_MB=50
FILE_SCAN_INLINE=true
VERIFY_CODE_SECRET=trial-only-verify-code-secret-0123456789abcdef
TRUST_INTAKE_SECRET=trial-only-trust-intake-secret-0123456789abcdef
# Internal CA for УЕП signatures (optional in a trial): pnpm pki:init-ca ~/puet-trial-ca
# PKI_CA_CERT_FILE=/home/<you>/puet-trial-ca/ca.crt.pem
# PKI_CA_KEY_FILE=/home/<you>/puet-trial-ca/ca.key.pem
# Calls: leave empty in a trial, or run LiveKit (docs/DEPLOYMENT.md, part 2)
LIVEKIT_URL=
