{
  "name": "@puet/api",
  "version": "0.1.0",
  "private": true,
  "description": "PUET.Pulse API (NestJS): REST + WebSocket gateway with zero-trust guards",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pki:init-ca": "tsx scripts/init-ca.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@fontsource/inter": "5.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "11.2.11",
    "@nestjs/websockets": "^11.1.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@puet/database": "workspace:*",
    "@puet/policy-engine": "workspace:*",
    "@puet/shared": "workspace:*",
    "asn1js": "3.0.6",
    "cookie": "^1.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "openid-client": "5.7.1",
    "pdf-lib": "1.17.1",
    "pkijs": "3.4.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@puet/e2ee": "workspace:*",
    "@puet/signing": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/qrcode": "1.5.6",
    "socket.io-client": "4.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
